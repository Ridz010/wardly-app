# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployment, used for metadata, sitemap, and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Enables AI analysis in Bedah, screenshot reading, and the Dity chat.
# Without it, Bedah still runs on the explainable rules and link checks.
OPEN_ROUTER_API_KEY=
# Must support images if screenshot reading is needed.
OPEN_ROUTER_MODEL=openai/gpt-4o-mini
